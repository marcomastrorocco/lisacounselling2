# The console edits these, so they live in the Blob store and are served by the
# function. A deployed copy would sit in front of it and never change.
#
# Every path here is anchored with a leading slash. Without one these read as
# gitignore-style basenames and match at any depth — plain "index.html" would
# take out admin/index.html as well, and the console loses its front door.
/index.html
/my-services/
/services/
/ndis-counselling/
/ndis-therapeutic-support/
/eap-counselling/
/about/
/approach/
/contact/
/domestic-family-violence/
/how-i-can-help/
/privacy/
/shell.js
/sitemap.xml
/admin/pages.json
/admin/profile.json

# Local-only state and secrets.
/admin/auth.json
/.env
/.env.local
/.env*.local
/LIVE-SECRETS.txt

# The dev server and the one-off scripts are not part of the deployment.
/local-server.js
/scripts/
/node_modules/
