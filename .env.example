# Copy this file to .env.local and fill in the values. .env.local is gitignored;
# never commit it. On Vercel these same names go in Project Settings →
# Environment Variables instead.

# Vercel Blob. Created for you when a Blob store is connected to the project;
# copy it from the store's .env.local tab, or run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# The password to sign in with until one is chosen in the console, and the way
# back in if that one is ever lost. Make it long.
SPES_ADMIN_PASSWORD=

# Signs the console's session cookie. Any long random string; changing it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
